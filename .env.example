# Application
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas: use a replica-set deployment for multi-document transactions
MONGODB_URI=
MONGODB_DB_NAME=neurosage

# Authentication: generate a unique random secret of at least 32 characters
AUTH_SECRET=

# Screening data encryption key: generate with `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=

# Initial administrator provisioning (used only by npm run seed:admin)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Brevo transactional email API (server-side secret; never use NEXT_PUBLIC_)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NeuroSage

# Public UPI display/payment parameters (not secrets)
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_PAYEE_NAME=NeuroSage
NEXT_PUBLIC_REGISTRATION_FEE_INR=
NEXT_PUBLIC_CAMP_NAME=NeuroSage Mental Wellness Camp
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional path for organizer-supplied QR image
NEXT_PUBLIC_UPI_QR_IMAGE=

# Optional comma-separated AKGEC options
NEXT_PUBLIC_AKGEC_BRANCHES=
NEXT_PUBLIC_AKGEC_SPECIALIZATIONS=
NEXT_PUBLIC_AKGEC_YEARS=1,2,3,4,5,Other

# Support and privacy contacts
SUPPORT_EMAIL=
PRIVACY_CONTACT_EMAIL=

# Set false to stop new registration submissions
REGISTRATION_OPEN=true
